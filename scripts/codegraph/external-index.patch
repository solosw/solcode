+/// Announce a real process that owns this connection. Windows has no stable
+/// parent pid (0 means unknown), so use this proxy's lifetime in that case;
+/// announcing 0 would make the daemon's dead-client sweep reap a live session.
+fn client_host_pid(host_pid: Option<u32>, parent_pid: u32) -> u32 {
+    host_pid
+        .filter(|&pid| pid != 0)
+        .or_else(|| (parent_pid != 0).then_some(parent_pid))
+        .unwrap_or_else(std::process::id)
+}
